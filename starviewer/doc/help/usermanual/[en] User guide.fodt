      <table:table-cell table:style-name="Taula12.A1" office:value-type="string">
       <text:p text:style-name="P103">D<text:span text:style-name="T958">escrip</text:span><text:span text:style-name="T1409">t</text:span><text:span text:style-name="T958">i</text:span><text:span text:style-name="T1409">on</text:span></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula12.A1" office:value-type="string">
       <text:p text:style-name="P122">Default value</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row table:style-name="Taula12.1">
     <table:table-cell table:style-name="Taula12.A2" office:value-type="string">
      <text:p text:style-name="P281">Listen to RIS requests on port</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula12.B2" office:value-type="string">
      <text:p text:style-name="P281">If enabled, Starviewer listens <text:span text:style-name="T1410">on</text:span> the indicated port waiting for a RIS request. It also affects integration <text:span text:style-name="T1410">with SAP</text:span>.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula12.C2" office:value-type="string">
      <text:p text:style-name="P213"><text:span text:style-name="T1410">Enabled</text:span><text:span text:style-name="T978">, 11110</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Taula12.1">
     <table:table-cell table:style-name="Taula12.A3" office:value-type="string">
      <text:p text:style-name="P285">Automatically view the studies upon reception</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula12.B3" office:value-type="string">
      <text:p text:style-name="P285">If enabled, studies requested by RIS or SAP are automatically retrieved and opened. Otherwise they are just retrieved.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula12.C3" office:value-type="string">
      <text:p text:style-name="P285">Enabled</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
