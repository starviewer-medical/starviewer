       </draw:frame><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">Figur</text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1221">e</text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"> </text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"><text:sequence text:ref-name="refFigure23" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">24</text:sequence></text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">:</text:span></text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="T379">PET-CT </text:span><text:span text:style-name="T407">fusion with different views. In the columns, from left to right: CT, fusion, PET. In the rows, from top to bottom: axial and coronal.</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:soft-page-break/>Ex<text:span text:style-name="T1170">a</text:span>mple</text:p>
   <text:h text:style-name="P781" text:outline-level="4"><text:bookmark-start text:name="__RefHeading___Toc29906_4233914545"/>Fusion layout<text:bookmark-end text:name="__RefHeading___Toc29906_4233914545"/></text:h>
   <text:p text:style-name="P590"><draw:frame draw:style-name="fr23" draw:name="Imatge141" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="473"><draw:image draw:mime-type="image/svg+xml">
