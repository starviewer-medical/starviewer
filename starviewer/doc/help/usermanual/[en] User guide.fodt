   <text:p text:style-name="P899">Func<text:span text:style-name="T1344">t</text:span>i<text:span text:style-name="T1165">on</text:span></text:p>
   <text:p text:style-name="P707">It enables or disables the manual synchronisation in all viewers at once.</text:p>
   <text:p text:style-name="P151">Shortcuts</text:p>
   <text:p text:style-name="P1866"><text:span text:style-name="Keyboard"><text:span text:style-name="T1">U</text:span></text:span><text:span text:style-name="T1"> (</text:span><text:span text:style-name="T278">to enable it</text:span><text:span text:style-name="T1">) </text:span><text:span text:style-name="T278">and</text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T1">Shift</text:span></text:span><text:span text:style-name="T1">+</text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T1">U</text:span></text:span><text:span text:style-name="T1"> (</text:span><text:span text:style-name="T278">to disable it</text:span><text:span text:style-name="T1">)</text:span></text:p>
   <text:p text:style-name="P900">Mode <text:span text:style-name="T1165">of operation</text:span></text:p>
   <text:p text:style-name="P2081"><text:span text:style-name="T122">C</text:span><text:span text:style-name="T278">lick</text:span><text:span text:style-name="T122"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T67"></text:span></text:span><text:span text:style-name="T122"> </text:span><text:span text:style-name="T356">on </text:span><text:span text:style-name="T278">the corresponding toolbar button or press the corresponding shortcut. The individual manual synchronisation buttons of each viewer are updated to reflect the new status.</text:span></text:p>
   <text:p text:style-name="P900">Vi<text:span text:style-name="T1165">ewer where it is applied</text:span></text:p>
   <text:p text:style-name="P707">All the viewers that have an image loaded.</text:p>
   <text:h text:style-name="P901" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc23334_171992829"/><text:span text:style-name="T1344">Automatic </text:span><text:span text:style-name="T1079">sy</text:span>nc<text:span text:style-name="T1344">h</text:span>roni<text:span text:style-name="T1079">s</text:span>a<text:span text:style-name="T1079">t</text:span>i<text:span text:style-name="T1079">on</text:span><text:bookmark-end text:name="__RefHeading___Toc23334_171992829"/></text:h>
   <text:p text:style-name="P579"><draw:frame draw:style-name="fr31" draw:name="Imatge132" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="460"><draw:image draw:mime-type="image/svg+xml">
      <office:binary-data>PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAx
       NiAxNiI+DQogIDxkZWZzIGlkPSJkZWZzMzA1MSI+DQogICAgPHN0eWxlIHR5cGU9InRleHQv
