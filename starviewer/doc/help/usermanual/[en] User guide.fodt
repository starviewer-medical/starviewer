         <text:p/>
        </draw:polyline><draw:polyline draw:style-name="gr3" draw:text-style-name="P2563" svg:width="4.199cm" svg:height="1.599cm" svg:x="7.202cm" svg:y="2.2cm" svg:viewBox="0 0 4200 1600" draw:points="3600,0 4200,0 4200,800 0,800 0,1600 600,1600">
