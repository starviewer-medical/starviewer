    <text:list-item>
     <text:p text:style-name="P2367"><text:span text:style-name="T1362">Females </text:span>(James): <text:span text:style-name="T956"><draw:frame draw:style-name="fr57" draw:name="Objecte4" text:anchor-type="as-char" svg:y="-0.681cm" svg:width="5.073cm" svg:height="1.124cm" draw:z-index="551"><draw:object>
