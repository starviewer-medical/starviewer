        </draw:polyline><draw:polyline draw:style-name="gr3" draw:text-style-name="P2563" svg:width="4.399cm" svg:height="3.999cm" svg:x="5.599cm" svg:y="0.6cm" svg:viewBox="0 0 4400 4000" draw:points="3800,3200 4400,3200 4400,4000 0,4000 0,0 2200,0">
