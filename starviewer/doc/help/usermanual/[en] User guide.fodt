       </draw:frame><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">Figur</text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1229">e</text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"> </text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"><text:sequence text:ref-name="refFigure17" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">18</text:sequence></text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">:</text:span></text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="T416">Playback s</text:span><text:span text:style-name="T376">ubmen</text:span><text:span text:style-name="T416">u</text:span><text:span text:style-name="T376">.</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:span text:style-name="T1">Mode </text:span><text:span text:style-name="T186">of operation</text:span></text:p>
   <text:p text:style-name="P2077"><text:span text:style-name="T1">Select the viewer where the images have to be automatically scrolled through and click</text:span><text:span text:style-name="T117"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T67"></text:span></text:span><text:span text:style-name="T117"> </text:span><text:span text:style-name="T1">the toolbar button.</text:span></text:p>
   <text:p text:style-name="P700">If the button’s submenu <text:span text:style-name="T1050">(Figur</text:span><text:span text:style-name="T1339">e</text:span><text:span text:style-name="T1050"> </text:span><text:span text:style-name="T1050"><text:sequence-ref text:reference-format="value" text:ref-name="refFigure17">18</text:sequence-ref></text:span><text:span text:style-name="T1050">)</text:span> is opened, different options <text:span text:style-name="T1339">that affect playback </text:span>can be chosen:</text:p>
   <text:list xml:id="list151012768117163" text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P2353">Scrolling speed</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P2396"><text:span text:style-name="Display"><text:span text:style-name="T273">L</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T810">oop</text:span></text:span><text:span text:style-name="T1">: </text:span><text:span text:style-name="T273">if enabled, when it reaches the end it returns to the beginning and continues</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P2307"><office:annotation office:name="__Annotation__7108_171992829" loext:resolved="false">
       <dc:creator>Autoria desconeguda</dc:creator>
       <dc:date>2019-12-13T10:51:13.351529474</dc:date>
       <text:p><text:span text:style-name="T1462">Atenció canviar-ho si retoquem el comportament</text:span></text:p>
      </office:annotation><text:span text:style-name="Display"><text:span text:style-name="T117">B</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T810">oo</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T117">merang</text:span></text:span><text:span text:style-name="T117">: </text:span><text:span text:style-name="T273">if enabled, it alternately scrolls through in one direction and in the other one by changing direction each time it reaches and end; it only works if the</text:span><text:span text:style-name="T118"> </text:span><text:span text:style-name="Display"><text:span text:style-name="T273">L</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T810">oop</text:span></text:span><text:span text:style-name="T273"> is enabled at the same time.</text:span><office:annotation-end office:name="__Annotation__7108_171992829"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P568">Vi<text:span text:style-name="T1161">ewer where it is applied</text:span></text:p>
   <text:p text:style-name="P567"><text:span text:style-name="T1339">The active viewer (with the blue frame). If the active viewer is changed while </text:span><text:span text:style-name="T1340">the tool is enabled, it affects the new active viewer.</text:span></text:p>
   <text:h text:style-name="P702" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc23324_171992829"/>Voxel information<text:bookmark-end text:name="__RefHeading___Toc23324_171992829"/></text:h>
