    <text:list-item>
     <text:p text:style-name="P2310"><text:a xlink:type="simple" xlink:href="#1.8.2.13.1.Informació textual|outline" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="T1370">Hide the patient&apos;s information of the viewer</text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P2310"><text:a xlink:type="simple" xlink:href="#1.9.6.Informació del vòxel|outline" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="T304">Visualise voxel information</text:span></text:a></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P605" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc16420_2479470819"/><text:soft-page-break/><text:span text:style-name="T1370">3D </text:span><text:span text:style-name="T1082">v</text:span>i<text:span text:style-name="T1082">ewer</text:span><text:bookmark-end text:name="__RefHeading___Toc16420_2479470819"/></text:h>
   <text:p text:style-name="P604">It visualises all the information of <text:span text:style-name="T1370">a series</text:span> in 3D <text:span text:style-name="T1370">by means of </text:span>volume rendering, <text:span text:style-name="T1370">with tools that allow the application of different colour functions or clipping a part of the volume.</text:span></text:p>
