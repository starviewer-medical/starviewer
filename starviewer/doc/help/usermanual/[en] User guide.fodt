   <text:p text:style-name="P784"><draw:frame draw:style-name="fr11" draw:name="Imatge147" text:anchor-type="paragraph" svg:width="2.646cm" svg:height="1.085cm" draw:z-index="479"><draw:image draw:mime-type="image/png">
