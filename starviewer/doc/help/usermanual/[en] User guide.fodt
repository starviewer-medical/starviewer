   <text:p text:style-name="P708"><draw:frame draw:style-name="fr11" draw:name="Imatge129" text:anchor-type="paragraph" svg:width="2.17cm" svg:height="1.085cm" draw:z-index="457"><draw:image draw:mime-type="image/png">
      <office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAFIAAAApCAIAAAApq+nOAAABD0lEQVRo3u2YMQrCMBSGXyWr
       g9ArvMG9eBBB8BCBHkE8QqAHcHTyINLdIVcoOHgAHQJSVNI0Ln2v/z+VQCBf/5f/Ly1oTtqd
       nuFhQbMUsIENbGADG9jABjawp6ji/ZkKt4GtVEbEKffLyz/bz4+tSGwiqqoqb2PbtlLdHpRz
