   <text:p text:style-name="P881">Func<text:span text:style-name="T1264">t</text:span>i<text:span text:style-name="T1106">on</text:span></text:p>
   <text:p text:style-name="P749">Increases or reduces image size.</text:p>
   <text:p text:style-name="P131">Shortcut</text:p>
   <text:p text:style-name="P1718"><text:span text:style-name="Keyboard"><text:span text:style-name="T1">Z</text:span></text:span></text:p>
   <text:p text:style-name="P881">Mode <text:span text:style-name="T1264">of operation</text:span></text:p>
   <text:p text:style-name="P1722"><office:annotation office:name="__Annotation__8094_826876881" loext:resolved="false">
