   <text:h text:style-name="P500" text:outline-level="5"><text:bookmark-start text:name="__RefHeading___Toc16753_3540127638"/><text:soft-page-break/>Shutters<text:bookmark-end text:name="__RefHeading___Toc16753_3540127638"/></text:h>
   <text:p text:style-name="P498"><draw:frame draw:style-name="fr23" draw:name="Imatge81" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="401"><draw:image draw:mime-type="image/svg+xml">
