   <text:p text:style-name="P482">Func<text:span text:style-name="T1281">t</text:span>i<text:span text:style-name="T1120">on</text:span></text:p>
   <text:p text:style-name="P484"><text:span text:style-name="T1281">They apply </text:span>90° <text:span text:style-name="T1281">rotations </text:span><text:span text:style-name="T1282">anti</text:span><text:span text:style-name="T1281">-clockwise and clockwise, respectively.</text:span></text:p>
   <text:p text:style-name="P136">Shortcuts</text:p>
   <text:p text:style-name="P1751"><text:span text:style-name="Keyboard"><text:span text:style-name="T1">F</text:span></text:span><text:span text:style-name="T1"> (anti-</text:span><text:span text:style-name="T232">clockwise</text:span><text:span text:style-name="T1">) i </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T1">G</text:span></text:span><text:span text:style-name="T1"> (</text:span><text:span text:style-name="T232">clockwise</text:span><text:span text:style-name="T1">)</text:span></text:p>
   <text:p text:style-name="P482">Mode <text:span text:style-name="T1121">of operation</text:span></text:p>
   <text:p text:style-name="P485">Select the viewer <text:span text:style-name="T1282">where the transformation has to be applied and </text:span>press the <text:span text:style-name="T1282">toolbar button</text:span> or the corresponding shortcut for each 90° <text:span text:style-name="T1282">turn</text:span> <text:span text:style-name="T1282">to be applied</text:span>.</text:p>
   <text:p text:style-name="P487">V<text:span text:style-name="T1121">iewer where it is applied</text:span></text:p>
   <text:p text:style-name="P486"><text:span text:style-name="T1282">The active viewer (with the blue frame)</text:span>.</text:p>
