   <text:p text:style-name="P2088"><text:span text:style-name="T135">If external applications have been defined in the Starviewer configuration, these will be displayed in the </text:span><text:span text:style-name="Display"><text:span text:style-name="T309">T</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T814">ools</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T135"> &gt; </text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T309">External </text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T814">a</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T135">p</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T309">p</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T135">lica</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T814">t</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T135">ions</text:span></text:span><text:span text:style-name="T135"> menu. </text:span><text:span text:style-name="T309">To learn how to configure them</text:span><text:span text:style-name="T135">, check section</text:span><text:span text:style-name="T136"> </text:span><text:span text:style-name="T136"><text:bookmark-ref text:reference-format="chapter" text:ref-name="__RefHeading___Toc41298_573806592">16.8</text:bookmark-ref></text:span><text:span text:style-name="T136"><text:s/></text:span><text:span text:style-name="T136"><text:bookmark-ref text:reference-format="text" text:ref-name="__RefHeading___Toc41298_573806592">External application</text:bookmark-ref></text:span><text:span text:style-name="T135">.</text:span></text:p>
