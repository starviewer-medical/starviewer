      <text:p text:style-name="P1431"><text:a xlink:type="simple" xlink:href="mailto:idi@idi.gencat.cat" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T890">idi@idi.gencat.cat</text:span></text:span></text:a></text:p>
      <text:p text:style-name="P1056">Tel. +34 93 259 41 75</text:p>
      <text:p text:style-name="P1058">Fax +34 93 259 41 85</text:p>
