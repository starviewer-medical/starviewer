       </draw:frame><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">Figur</text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1212">e</text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"> </text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"><text:sequence text:ref-name="refFigure12" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">13</text:sequence></text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">: </text:span></text:span><text:span text:style-name="T400">Left</text:span><text:span text:style-name="T368">: </text:span><text:span text:style-name="T400">viewer with visible shutters</text:span><text:span text:style-name="T368">. </text:span><text:span text:style-name="T400">Right</text:span><text:span text:style-name="T368">:</text:span><text:span text:style-name="T369"> </text:span><text:span text:style-name="T400">same viewer with hidden shutters</text:span><text:span text:style-name="T373">.</text:span></text:p>
     </draw:text-box>
    </draw:frame>Ex<text:span text:style-name="T1130">a</text:span>mple</text:p>
   <text:h text:style-name="P1518" text:outline-level="4"><text:bookmark-start text:name="__RefHeading___Toc16755_3540127638"/><text:soft-page-break/>Screenshot<text:bookmark-end text:name="__RefHeading___Toc16755_3540127638"/></text:h>
   <text:p text:style-name="P503"><draw:frame draw:style-name="fr23" draw:name="Imatge84" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="405"><draw:image draw:mime-type="image/svg+xml">
