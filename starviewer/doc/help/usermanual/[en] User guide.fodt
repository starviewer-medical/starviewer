     <table:table-cell table:style-name="Taula10.A2" office:value-type="string">
      <text:p text:style-name="P193"><text:span text:style-name="T1408">Local machine </text:span>A<text:span text:style-name="T976">E Title</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula10.B2" office:value-type="string">
      <text:p text:style-name="P280">The DICOM identifier of this machine that is sent to the PACS.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula10.C2" office:value-type="string">
      <text:p text:style-name="P212"><text:span text:style-name="T1408">The</text:span><text:span text:style-name="T976"> hostname </text:span><text:span text:style-name="T1408">of the machine</text:span></text:p>
