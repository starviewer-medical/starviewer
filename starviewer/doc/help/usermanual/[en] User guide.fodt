      <table:table-cell table:style-name="Taula10.A1" office:value-type="string">
       <text:p text:style-name="P111">Op<text:span text:style-name="T1408">t</text:span>ions</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula10.A1" office:value-type="string">
       <text:p text:style-name="P102">D<text:span text:style-name="T958">escrip</text:span><text:span text:style-name="T1408">t</text:span><text:span text:style-name="T958">i</text:span><text:span text:style-name="T1408">on</text:span></text:p>
