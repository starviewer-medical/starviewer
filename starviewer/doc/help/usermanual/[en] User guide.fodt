   <text:p text:style-name="P215"><text:span text:style-name="T1363">Where</text:span>:</text:p>
   <text:list xml:id="list151013176799530" text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P2411"><text:span text:style-name="Citation"><text:span text:style-name="T1">W</text:span></text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="T300">is the weight of the patient in</text:span><text:span text:style-name="T1"> kg</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P2309"><text:span text:style-name="Citation"><text:span text:style-name="T47">H</text:span></text:span><text:span text:style-name="T47"> </text:span><text:span text:style-name="T300">is the height of the patient in </text:span><text:span text:style-name="T47">cm</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P719" text:outline-level="5"><text:bookmark-start text:name="__RefHeading___Toc29920_4233914545"/>Body surface area<text:bookmark-end text:name="__RefHeading___Toc29920_4233914545"/></text:h>
   <text:p text:style-name="P215"><text:span text:style-name="T1363">To obtain this value, the</text:span> Du Boi<text:span text:style-name="T1363">s’</text:span><text:note text:id="ftn13" text:note-class="footnote"><text:note-citation>13</text:note-citation><text:note-body>
      <text:p text:style-name="P1419"><text:span text:style-name="T1">Delafield Du Bois, Eugene F. Du Bois. </text:span><text:span text:style-name="Definition"><text:span text:style-name="T1">A formula to estimate the approximate surface area if height and weight be known.</text:span></text:span><text:span text:style-name="T1"> Archives of Internal Medicine. 1916, Vol. 17, 6-2, pp. 863–871.</text:span></text:p></text:note-body></text:note> <text:span text:style-name="T1363">formula is used:</text:span></text:p>
   <text:p text:style-name="P215"><draw:frame draw:style-name="fr57" draw:name="Objecte5" text:anchor-type="as-char" svg:y="-0.436cm" svg:width="5.147cm" svg:height="0.626cm" draw:z-index="552"><draw:object>
      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
       <semantics>
        <mrow>
         <msub>
          <mi mathvariant="italic">BSA</mi>
          <msup>
           <mi mathvariant="italic">cm</mi>
           <mn>2</mn>
          </msup>
         </msub>
         <mo stretchy="false">=</mo>
         <mrow>
          <mn>71.84</mn>
          <mo stretchy="false">×</mo>
          <msup>
           <mi>H</mi>
           <mn>0.725</mn>
          </msup>
          <mo stretchy="false">×</mo>
          <msup>
           <mi>W</mi>
           <mn>0.425</mn>
          </msup>
         </mrow>
        </mrow>
        <annotation encoding="StarMath 5.0">BSA_{cm^2} = 71.84 times H^0.725 times W^0.425</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
