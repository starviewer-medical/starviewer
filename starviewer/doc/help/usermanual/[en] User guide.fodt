      </draw:frame><text:span text:style-name="T245">By opening the series selection menu (right click</text:span><text:span text:style-name="T103"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T103"></text:span></text:span><text:span text:style-name="T103">)</text:span><text:span text:style-name="T245"> we see that the new series has appeared and we can assign it to the viewer.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P684" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc14095_2856793398"/>Measurement and drawing tools<text:bookmark-end text:name="__RefHeading___Toc14095_2856793398"/></text:h>
   <text:h text:style-name="P515" text:outline-level="4"><text:bookmark-start text:name="__RefHeading___Toc14097_2856793398"/>Dist<text:span text:style-name="T1026">a</text:span>nc<text:span text:style-name="T1026">e</text:span><text:bookmark-end text:name="__RefHeading___Toc14097_2856793398"/></text:h>
   <text:p text:style-name="P512"><draw:frame draw:style-name="fr23" draw:name="Imatge90" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="412"><draw:image draw:mime-type="image/svg+xml">
      <office:binary-data>PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAx
