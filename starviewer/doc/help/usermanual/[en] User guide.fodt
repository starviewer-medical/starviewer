   <text:h text:style-name="P622" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc24540_1084088360"/><text:soft-page-break/>Visuali<text:span text:style-name="T1086">s</text:span>a<text:span text:style-name="T1086">t</text:span>i<text:span text:style-name="T1086">on</text:span><text:bookmark-end text:name="__RefHeading___Toc24540_1084088360"/></text:h>
   <text:p text:style-name="P788">Once a study has been opened, users can choose between different viewer types or extensions that provide different functionalities:</text:p>
   <text:list xml:id="list151014274507531" text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P2314"><text:a xlink:type="simple" xlink:href="#1.11.Impressió DICOM|outline" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Citation"><text:span text:style-name="T328">DICOM Print</text:span></text:span></text:a></text:p>
