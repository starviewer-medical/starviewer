   <text:h text:style-name="P967" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc89466_458067131"/>Configura<text:span text:style-name="T995">t</text:span>ions<text:bookmark-end text:name="__RefHeading___Toc89466_458067131"/></text:h>
   <text:p text:style-name="P2094"><text:span text:style-name="T337">The configuration window, accessible from the</text:span><text:span text:style-name="T146"> </text:span><text:span text:style-name="Display"><text:span text:style-name="T337">T</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T821">ool</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T146">s &gt; Configura</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T821">t</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T146">i</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T821">on</text:span></text:span><text:span text:style-name="T146"> </text:span><text:span text:style-name="T337">menu, allows configuring various elements to fit the user’s preferences. Parameters are grouped into different sections which can be selected from the left panel of the window:</text:span></text:p>
   <text:list xml:id="list151014561014367" text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P2373"><text:bookmark-ref text:reference-format="text" text:ref-name="__RefHeading___Toc41282_573806592">2D viewer</text:bookmark-ref></text:p>
    </text:list-item>
    <text:list-item>
