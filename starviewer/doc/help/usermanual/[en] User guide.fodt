    </draw:frame>Ex<text:span text:style-name="T1155">a</text:span><text:span text:style-name="T934">mple</text:span><text:span text:style-name="T1424">s</text:span></text:p>
   <text:h text:style-name="P2260" text:outline-level="4"><text:bookmark-start text:name="__RefHeading___Toc49353_3061264314"/>Change reconstruction in all viewers<text:bookmark-end text:name="__RefHeading___Toc49353_3061264314"/></text:h>
   <text:p text:style-name="Heading">Function</text:p>
   <text:p text:style-name="P2259">It changes the slice plane in all viewers.</text:p>
   <text:p text:style-name="Heading">Shortcuts</text:p>
   <text:p text:style-name="P2261"><text:span text:style-name="Keyboard">Ctrl</text:span>+<text:span text:style-name="Keyboard">Shift</text:span>+<text:span text:style-name="Keyboard">1</text:span> (axial), <text:span text:style-name="Keyboard">Ctrl</text:span>+<text:span text:style-name="Keyboard">Shift</text:span>+<text:span text:style-name="Keyboard">2</text:span> (sagit<text:span text:style-name="T1442">t</text:span>al), <text:span text:style-name="Keyboard">Ctrl</text:span>+<text:span text:style-name="Keyboard">Shift</text:span>+<text:span text:style-name="Keyboard">3</text:span> (coronal)</text:p>
   <text:p text:style-name="Heading">Mode of operation</text:p>
   <text:p text:style-name="P1306"><text:span text:style-name="T1">Select </text:span><text:span text:style-name="T359">any viewer</text:span><text:span text:style-name="T1"> and </text:span><text:span text:style-name="T359">double </text:span><text:span text:style-name="T1">click</text:span><text:span text:style-name="T265"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T67"></text:span></text:span><text:span text:style-name="T265"> </text:span><text:span text:style-name="T359">or </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T359">Shift</text:span></text:span><text:span text:style-name="T359">+click </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T67"></text:span></text:span><text:span text:style-name="T359"> </text:span><text:span text:style-name="T1">the corresponding icon. The image is immediately reconstructed with the selected plane </text:span><text:span text:style-name="T359">in all viewers</text:span><text:span text:style-name="T1">.</text:span></text:p>
   <text:p text:style-name="Heading"><text:soft-page-break/>Viewer where it is applied</text:p>
   <text:p text:style-name="P2259">All.</text:p>
   <text:h text:style-name="P554" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc23316_171992829"/>Thick slab<text:bookmark-end text:name="__RefHeading___Toc23316_171992829"/></text:h>
