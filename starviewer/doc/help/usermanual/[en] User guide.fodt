   <text:h text:style-name="P996" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc7647_826876881"/><text:soft-page-break/>Image manipulation tools<text:bookmark-end text:name="__RefHeading___Toc7647_826876881"/></text:h>
   <text:h text:style-name="P185" text:outline-level="4"><text:bookmark-start text:name="__RefHeading___Toc7649_826876881"/><text:span text:style-name="T1019">Scrolling and </text:span><text:span text:style-name="T1020">phase change</text:span><text:bookmark-end text:name="__RefHeading___Toc7649_826876881"/></text:h>
   <text:p text:style-name="P1516"><draw:frame draw:style-name="fr23" draw:name="Imatge43" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="352"><draw:image draw:mime-type="image/svg+xml">
      <office:binary-data>PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAx
