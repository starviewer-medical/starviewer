         </draw:frame><text:span text:style-name="Caption_20_characters">Figur</text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1448">e</text:span></text:span><text:span text:style-name="Caption_20_characters"> </text:span><text:span text:style-name="Caption_20_characters"><text:sequence text:ref-name="refFigure30" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">31</text:sequence></text:span><text:span text:style-name="Caption_20_characters">:</text:span> <text:span text:style-name="T1449">Dif</text:span><text:span text:style-name="T1448">f</text:span><text:span text:style-name="T1449">erent variants </text:span><text:span text:style-name="T1448">of the dialogue to add a new PACS</text:span><text:span text:style-name="T447">. </text:span><text:span text:style-name="T448">Left</text:span><text:span text:style-name="T449">: </text:span><text:span text:style-name="T448">DIMSE</text:span><text:span text:style-name="T449"> PACS. Centre: </text:span><text:span text:style-name="T448">WADO</text:span><text:span text:style-name="T449"> PACS. </text:span><text:span text:style-name="T448">Right: hybrid</text:span><text:span text:style-name="T449"> PACS.</text:span></text:p>
       </draw:text-box>
      </draw:frame><text:span text:style-name="Emphasis">WADO-URI + DIMSE</text:span>: <text:span text:style-name="T1448">also called hybrid PACS</text:span>, <text:span text:style-name="T1448">in this case the WADO-URI protocol is used for the searches and </text:span>DIMSE-C (C-MOVE, C-STORE) <text:span text:style-name="T1448">to transfer the files</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P2096"><text:soft-page-break/><text:span text:style-name="T1">The</text:span><text:span text:style-name="T152"> </text:span><text:span text:style-name="Display"><text:span text:style-name="T347">T</text:span></text:span><text:span text:style-name="Display"><text:span text:style-name="T822">est</text:span></text:span><text:span text:style-name="T152"> </text:span><text:span text:style-name="T1">button </text:span><text:span text:style-name="T362">in the dialogue to add or edit a PACS</text:span><text:span text:style-name="T1"> allows testing whether a server </text:span><text:span text:style-name="T347">is responding taking into account the current field settings.</text:span></text:p>
