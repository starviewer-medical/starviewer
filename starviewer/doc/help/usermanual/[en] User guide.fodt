   <text:p text:style-name="P780"><draw:frame draw:style-name="fr11" draw:name="Imatge142" text:anchor-type="paragraph" svg:width="2.646cm" svg:height="1.085cm" draw:z-index="474"><draw:image draw:mime-type="image/png">
      <office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAGQAAAApCAIAAABMRhuxAAACo0lEQVRo3u2ZsWvqUBTGT0QU
