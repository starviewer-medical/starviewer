     <dc:date>2019-12-04T14:11:37.156336865</dc:date>
     <text:p text:style-name="P2560"><text:span text:style-name="T1462">Repassar la coherència de formes personals, temps verbals, to, etc.</text:span></text:p>
    </office:annotation><text:span text:style-name="T210">Drag the</text:span><office:annotation-end office:name="__Annotation__8094_826876881"/><text:span text:style-name="T1"> </text:span><text:span text:style-name="T210">mouse up or down within a 2D viewer while </text:span><text:span text:style-name="T211">holding down</text:span><text:span text:style-name="T210"> the left </text:span><text:span text:style-name="T356">mouse </text:span><text:span text:style-name="T210">button</text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T67"></text:span></text:span><text:span text:style-name="T210">. Zoom is centred </text:span><text:span text:style-name="T211">at</text:span><text:span text:style-name="T210"> the </text:span><text:span text:style-name="T211">point that has been first clicked</text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T67"></text:span></text:span><text:span text:style-name="T1">.</text:span></text:p>
   <text:p text:style-name="P156">Viewer where it is applied</text:p>
   <text:p text:style-name="P750">The viewer where the dragging has started.</text:p>
