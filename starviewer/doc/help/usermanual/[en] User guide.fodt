      <text:p text:style-name="P244">Normalisation factor selected (body weight, lean body mass or body surface area)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Taula4.C5" office:value-type="string">
      <text:p text:style-name="P205">g (<text:span text:style-name="T1360">body weight and lean body mass</text:span>)</text:p>
      <text:p text:style-name="P205">cm² (<text:span text:style-name="T1360">body surface area</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="P248" text:outline-level="5"><text:bookmark-start text:name="__RefHeading___Toc29916_4233914545"/>Decay correction factor<text:bookmark-end text:name="__RefHeading___Toc29916_4233914545"/></text:h>
   <text:p text:style-name="P1901"><text:span text:style-name="T298">The injected dose</text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="Citation"><text:span text:style-name="T1">Dᵢ</text:span></text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="T298">to calculate the</text:span><text:span text:style-name="T1"> SUV </text:span><text:span text:style-name="T298">is corrected by the radioactive decay factor that exists between the injection time and the beginning of the acquisition through the formula</text:span><text:span text:style-name="T1"><text:note text:id="ftn10" text:note-class="footnote"><text:note-citation>10</text:note-citation><text:note-body>
       <text:p text:style-name="Footnote"><text:a xlink:type="simple" xlink:href="https://en.wikipedia.org/wiki/Exponential_decay#Half-life" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="T354">https://en.wikipedia.org/wiki/Exponential_decay#Half-life</text:span></text:a></text:p></text:note-body></text:note></text:span></text:p>
   <text:p text:style-name="P597"><draw:frame draw:style-name="fr57" draw:name="Objecte2" text:anchor-type="as-char" svg:y="-0.824cm" svg:width="1.543cm" svg:height="0.923cm" draw:z-index="549"><draw:object>
      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
       <semantics>
        <mrow>
         <mi>d</mi>
         <mo stretchy="false">=</mo>
         <msup>
          <mn>2</mn>
          <mrow>
           <mo fence="true" form="prefix" stretchy="true">(</mo>
           <mrow>
            <mfrac>
             <mrow>
              <mrow>
               <mo stretchy="false">−</mo>
               <mi mathvariant="normal">Δ</mi>
              </mrow>
              <mi>t</mi>
             </mrow>
             <msub>
              <mi>T</mi>
              <mrow>
               <mn>1</mn>
               <mo stretchy="false">/</mo>
               <mn>2</mn>
              </mrow>
             </msub>
            </mfrac>
           </mrow>
           <mo fence="true" form="postfix" stretchy="true">)</mo>
          </mrow>
         </msup>
        </mrow>
        <annotation encoding="StarMath 5.0">d = 2^left( {-%DELTA t} over T_{1/2} right)</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
