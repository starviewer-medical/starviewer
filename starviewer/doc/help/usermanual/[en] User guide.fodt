   <text:p text:style-name="P526"><draw:frame draw:style-name="fr23" draw:name="Imatge100" text:anchor-type="paragraph" svg:width="1cm" svg:height="1cm" draw:z-index="422"><draw:image draw:mime-type="image/svg+xml">
