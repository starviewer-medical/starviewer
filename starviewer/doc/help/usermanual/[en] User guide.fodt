     </draw:image>
    </draw:frame><text:span text:style-name="T323">To add a printer, click</text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="Keyboard"><text:span text:style-name="T134"></text:span></text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="T323">the button next to the printer selection drop-down menu </text:span><text:span text:style-name="T139">(</text:span><text:span text:style-name="T139"><draw:frame draw:style-name="fr19" draw:name="Imatge170" text:anchor-type="as-char" svg:width="0.499cm" svg:height="0.499cm" draw:z-index="553"><draw:image draw:mime-type="image/svg+xml">
       <office:binary-data>PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAx
