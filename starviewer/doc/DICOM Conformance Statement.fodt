        </draw:connector><draw:custom-shape draw:style-name="gr3" draw:text-style-name="P689" xml:id="id3" draw:id="id3" svg:width="1.999cm" svg:height="1.001cm" svg:x="0cm" svg:y="2cm">
         <text:p text:style-name="P688"><text:span text:style-name="T232">Printer</text:span></text:p>
         <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/>
        </draw:custom-shape><draw:connector draw:style-name="gr4" draw:text-style-name="P691" draw:type="line" svg:x1="6.999cm" svg:y1="2.498cm" svg:x2="1.998cm" svg:y2="2.499cm" draw:start-shape="id1" draw:start-glue-point="6" draw:end-shape="id3" draw:end-glue-point="1" svg:d="M6999 2498l-5001 1" svg:viewBox="0 0 5002 4">
         <text:p text:style-name="P690"><text:span text:style-name="T232">Printing</text:span></text:p>
        </draw:connector><draw:custom-shape draw:style-name="gr5" draw:text-style-name="P689" xml:id="id4" draw:id="id4" svg:width="2.001cm" svg:height="1.001cm" svg:x="14.998cm" svg:y="0cm">
         <draw:glue-point draw:id="4" svg:x="-5.053cm" svg:y="5.115cm"/>
         <text:p text:style-name="P688"><text:span text:style-name="T232">PACS</text:span></text:p>
         <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/>
        </draw:custom-shape><draw:connector draw:style-name="gr4" draw:text-style-name="P691" draw:type="line" svg:x1="9.998cm" svg:y1="0.501cm" svg:x2="14.998cm" svg:y2="0.499cm" draw:start-shape="id1" draw:start-glue-point="7" draw:end-shape="id4" draw:end-glue-point="3" svg:d="M9998 501l5000-2" svg:viewBox="0 0 5002 4">
         <text:p text:style-name="P690"><text:span text:style-name="T232">URI Service</text:span></text:p>
         <text:p text:style-name="P690"><text:span text:style-name="T232">Studies Service</text:span></text:p>
        </draw:connector><draw:connector draw:style-name="gr4" draw:text-style-name="P691" draw:type="line" svg:x1="9.998cm" svg:y1="2.298cm" svg:x2="15.501cm" svg:y2="2.3cm" draw:start-shape="id1" draw:start-glue-point="8" draw:end-shape="id5" draw:end-glue-point="9" svg:d="M9998 2298l5503 2" svg:viewBox="0 0 5505 4">
         <text:p text:style-name="P690"><text:span text:style-name="T232">File-set Creator</text:span></text:p>
        </draw:connector><draw:connector draw:style-name="gr4" draw:text-style-name="P691" draw:type="line" svg:x1="15.501cm" svg:y1="2.699cm" svg:x2="9.998cm" svg:y2="2.699cm" draw:start-shape="id5" draw:start-glue-point="10" draw:end-shape="id1" draw:end-glue-point="9" svg:d="M15501 2699h-5503" svg:viewBox="0 0 5505 2">
         <text:p text:style-name="P690"><text:span text:style-name="T232">File-set Reader</text:span></text:p>
        </draw:connector><draw:custom-shape draw:style-name="gr6" draw:text-style-name="P691" xml:id="id5" draw:id="id5" svg:width="0.999cm" svg:height="1.001cm" svg:x="15.499cm" svg:y="2cm">
         <draw:glue-point draw:id="9" svg:x="-4.994cm" svg:y="-2.002cm"/>
         <draw:glue-point draw:id="10" svg:x="-4.994cm" svg:y="2.002cm"/>
         <text:p/>
         <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 6800 10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 6800 21600 18200" draw:type="flowchart-magnetic-disk" draw:enhanced-path="M 0 3400 Y 10800 0 21600 3400 L 21600 18200 Y 10800 21600 0 18200 Z N M 0 3400 Y 10800 6800 21600 3400 N"/>
        </draw:custom-shape>
       </draw:g><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">Figure </text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1"><text:sequence text:ref-name="refFigure0" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">1</text:sequence></text:span></text:span><text:span text:style-name="Caption_20_characters"><text:span text:style-name="T1">:</text:span></text:span><text:span text:style-name="T1"> </text:span><text:span text:style-name="T4">Overview of Implemented Services</text:span></text:p>
     </draw:text-box>
    </draw:frame>Details on the implementation of each functionality are provided along this DICOM Conformance Statement.</text:p>
   <text:h text:style-name="P341" text:outline-level="3"><text:bookmark-start text:name="__RefHeading___Toc2434_1692806117"/>Content and Transfer<text:bookmark-end text:name="__RefHeading___Toc2434_1692806117"/></text:h>
   <text:p text:style-name="P77"><text:span text:style-name="T222">Table </text:span><text:span text:style-name="T222"><text:sequence-ref text:reference-format="value" text:ref-name="refTable0">1</text:sequence-ref></text:span><text:s/>lists all Storage SOP Classes and the supported transfer mechanisms as well as the usage scenarios for those instances.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body>
      <text:p text:style-name="P628">More Image Storage SOP Classes may actually be supported for Display and more non-image Storage SOP Classes may actually be supported for Archive, but they have not been tested.</text:p></text:note-body></text:note></text:p>
   <text:p text:style-name="P77">The “Transfer Syntax Set” column lists the sets of Transfer Syntaxes defined in <text:span text:style-name="T222">Table </text:span><text:span text:style-name="T222"><text:sequence-ref text:reference-format="value" text:ref-name="refTable1">2</text:sequence-ref></text:span><text:s/>that are applicable to each SOP Class. The “DIMSE”, “DICOM Web” and “Media Services” columns indicate the roles supported for each SOP Class.</text:p>
   <text:p text:style-name="P77">The “Function” columns indicate how the instances are used by the system:</text:p>
   <text:list xml:id="list155340852787371" text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P663">Create: The system creates instances of the SOP Class. The type of the created SOP Class is indicated by one of the following abbreviations:</text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P663">S: Standard SOP Class</text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P663">SE: Standard Extended SOP Class</text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P663">SP: Specialized SOP Class</text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P663"><text:soft-page-break/>P: Private SOP Class</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P663">Display: The system displays the instances of the SOP Class to the user, either by displaying the SOP Instances natively or by applying instances of another suitable SOP Class to the image instances (e.g., a Presentation State or CAD SR).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P663">Process: The system processes the instances of the SOP Class to derive some further information that is made available to the user (e.g., a CAD processing algorithm, or a 3D Rendering).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P663">Archive: The system stores the instances of the SOP Class and makes them available again.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P658"><text:span text:style-name="Caption_20_characters">Table </text:span><text:span text:style-name="Caption_20_characters"><text:sequence text:ref-name="refTable0" text:name="Table" text:formula="ooow:Table+1" style:num-format="1">1</text:sequence></text:span><text:span text:style-name="Caption_20_characters">:</text:span> Storage SOP Classes</text:p>
   <table:table table:name="Taula1" table:style-name="Taula1">
    <table:table-column table:style-name="Taula1.A"/>
    <table:table-column table:style-name="Taula1.B"/>
    <table:table-column table:style-name="Taula1.C" table:number-columns-repeated="12"/>
    <table:table-header-rows>
     <table:table-row table:style-name="Taula1.1">
      <table:table-cell table:style-name="Taula1.A1" table:number-columns-spanned="2" office:value-type="string">
       <text:p text:style-name="P343"><office:annotation office:name="__Annotation__23092_2829065918" loext:resolved="false">
         <dc:creator>Autoria desconeguda</dc:creator>
         <dc:date>2023-09-15T14:16:02.761955073</dc:date>
         <text:p text:style-name="P685"><text:span text:style-name="T229">Quan volguem actualitzar, la llista completa és a </text:span><text:span text:style-name="T229"><text:a xlink:href="https://dicom.nema.org/medical/dicom/current/output/html/part04.html#sect_B.5" xlink:type="simple">https://dicom.nema.org/medical/dicom/current/output/html/part04.html#sect_B.5</text:a></text:span></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229"/></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229">Ara hi ha les de dcmShortSCUStorageSOPClassUIDs (a dcuid.cc) que són les que diem que acceptem a pacsconnection.cpp.</text:span></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229"/></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229">També podem inspeccionar les associacions amb el Wireshark.</text:span></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229"/></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T230">Important: s’han d’ordenar per UID (el mateix ordre de la taula font).</text:span></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229"/></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229">Moltes de les que hem posat s’haurien de comprovar en realitat sobre què es pot fer amb elles.</text:span></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T229"/></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T230">També cal vigilar el transfer syntax set per les no imatges</text:span></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T230"/></text:p>
         <text:p text:style-name="P685"><text:span text:style-name="T230">Molt probablement caldria afegir moltes més classes per incloure les que podem descarregar amb WADO (totes o quasi totes si sabem l’UID).</text:span></text:p>
        </office:annotation>SOP Classes<office:annotation-end office:name="__Annotation__23092_2829065918"/></text:p>
      </table:table-cell>
      <table:covered-table-cell/>
      <table:table-cell table:style-name="Taula1.A1" office:value-type="string">
       <text:p text:style-name="P343"><office:annotation office:name="__Annotation__22489_2829065918" loext:resolved="false">
         <dc:creator>Autoria desconeguda</dc:creator>
         <dc:date>2023-09-15T13:53:18.483338020</dc:date>
         <text:p text:style-name="P685"><text:span text:style-name="T229">Provar amb altres PACS a veure si realment suportem LL</text:span></text:p>
        </office:annotation>Transfer Syntax Set<office:annotation-end office:name="__Annotation__22489_2829065918"/></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula1.A1" table:number-columns-spanned="2" office:value-type="string">
       <text:p text:style-name="P343">DIMSE Services</text:p>
      </table:table-cell>
      <table:covered-table-cell/>
      <table:table-cell table:style-name="Taula1.A1" table:number-columns-spanned="2" office:value-type="string">
       <text:p text:style-name="P343"><office:annotation office:name="__Annotation__28598_2829065918" loext:resolved="false">
         <dc:creator>Autoria desconeguda</dc:creator>
         <dc:date>2023-09-15T18:48:30.640442253</dc:date>
         <text:p text:style-name="P685"><text:span text:style-name="T229">M’he basat en els que que accepta el C-STORE per rebre del PACS. Cal comprovar si realment els podem descarregar amb WADO o importar de DICOMDIR o crear en DICOMDIR</text:span></text:p>
        </office:annotation>DICOM Web Services<office:annotation-end office:name="__Annotation__28598_2829065918"/></text:p>
      </table:table-cell>
      <table:covered-table-cell/>
      <table:table-cell table:style-name="Taula1.A1" table:number-columns-spanned="3" office:value-type="string">
       <text:p text:style-name="P343">Media Services</text:p>
      </table:table-cell>
      <table:covered-table-cell/>
      <table:covered-table-cell/>
      <table:table-cell table:style-name="Taula1.A1" table:number-columns-spanned="4" office:value-type="string">
       <text:p text:style-name="P343">Function</text:p>
      </table:table-cell>
      <table:covered-table-cell/>
      <table:covered-table-cell/>
      <table:covered-table-cell/>
     </table:table-row>
     <table:table-row table:style-name="Taula1.1">
      <table:table-cell table:style-name="Taula1.A2" table:number-columns-spanned="2" office:value-type="string">
       <text:p text:style-name="Table_20_Heading"/>
      </table:table-cell>
      <table:covered-table-cell/>
      <table:table-cell table:style-name="Taula1.C2" office:value-type="string">
       <text:p text:style-name="Table_20_Heading"/>
      </table:table-cell>
      <table:table-cell table:style-name="Taula1.D2" office:value-type="string">
       <text:p text:style-name="P631">SCU</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula1.E2" office:value-type="string">
       <text:p text:style-name="P631"><office:annotation office:name="__Annotation__22488_2829065918" loext:resolved="false">
         <dc:creator>Autoria desconeguda</dc:creator>
         <dc:date>2023-09-15T13:52:40.463038504</dc:date>
         <text:p text:style-name="P685"><text:span text:style-name="T229">Com a receptors de dades (revisar)</text:span></text:p>
        </office:annotation>SCP<office:annotation-end office:name="__Annotation__22488_2829065918"/></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula1.F2" office:value-type="string">
       <text:p text:style-name="P631">UA</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula1.G2" office:value-type="string">
       <text:p text:style-name="P631">OS</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Taula1.H2" office:value-type="string">
