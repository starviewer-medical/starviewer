   </text:sequence-decls>
   <text:p text:style-name="P659"><draw:frame draw:style-name="fr5" draw:name="tpl_firstPageTitle_txt" text:anchor-type="paragraph" svg:width="9.999cm" draw:z-index="100">
     <draw:text-box fo:min-height="9.999cm">
      <text:p text:style-name="First_20_page_20_title"><text:subject>Starviewer 2.0</text:subject></text:p>
      <text:p text:style-name="First_20_page_20_subtitle"><text:bookmark-start text:name="__RefHeading___Toc89464_458067131"/><text:title>DICOM Conformance Statement</text:title><text:bookmark-end text:name="__RefHeading___Toc89464_458067131"/></text:p>
     </draw:text-box>
    </draw:frame><draw:frame draw:style-name="fr4" draw:name="tpl_firstPageComments_txt" text:anchor-type="paragraph" svg:width="17cm" style:rel-width="100%" draw:z-index="101">
     <draw:text-box fo:min-height="2cm">
      <text:p text:style-name="P78"><text:description/></text:p>
     </draw:text-box>
    </draw:frame></text:p>
   <text:h text:style-name="P636" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2432_1692806117"/><office:annotation office:name="__Annotation__25032_2829065918" loext:resolved="false">
     <dc:creator>Autoria desconeguda</dc:creator>
     <dc:date>2023-09-15T15:11:07.650579973</dc:date>
     <text:p text:style-name="P685"><text:span text:style-name="T229">Estructura marcada per </text:span><text:span text:style-name="T229"><text:a xlink:href="https://dicom.nema.org/medical/dicom/current/output/html/part02.html#chapter_N" xlink:type="simple">https://dicom.nema.org/medical/dicom/current/output/html/part02.html#chapter_N</text:a></text:span></text:p>
    </office:annotation><text:span text:style-name="T45">O</text:span><text:span text:style-name="T48">verview</text:span><office:annotation-end office:name="__Annotation__25032_2829065918"/><text:bookmark-end text:name="__RefHeading___Toc2432_1692806117"/></text:h>
   <text:p text:style-name="P372">Starviewer is a DICOM viewer that integrates image visualisation and assessment tools for medical image diagnosis, reconstruction techniques, 3D navigation tools and image fusion support. It adds functional modules and it may be integrated with healthcare information systems such as PACS and RIS servers.</text:p>
   <text:p text:style-name="P373">The following DICOM features are supported:</text:p>
   <text:list xml:id="list4160554604" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P662">Visualisation of most image modalities in 2D and 3D.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P662">Extraction of encapsulated PDFs to open them in the operating system PDF viewer.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P662">Communication with PACS using DIMSE-C and DICOMWeb protocols.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P662">Printing with a DICOM printer.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P662">Opening and creating DICOMDIRs.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P373"><draw:frame draw:style-name="fr3" draw:name="starcat_txt" text:anchor-type="paragraph" svg:width="17cm" style:rel-width="100%" draw:z-index="102">
     <draw:text-box fo:min-height="0.041cm">
