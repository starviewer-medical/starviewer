     <table:table-cell table:style-name="Taula1.A62" office:value-type="string">
      <text:p text:style-name="P350"><office:annotation office:name="__Annotation__71370_3974847206" loext:resolved="false">
        <dc:creator>Autoria desconeguda</dc:creator>
        <dc:date>2024-03-04T15:58:45.990332780</dc:date>
        <text:p text:style-name="P685"><text:span text:style-name="T229">Es pot visualitzar perquè té pixel data però no té sentit una visualització directa. Aclarir-ho en una nota al peu.</text:span></text:p>
       </office:annotation>RT Dose Storage<office:annotation-end office:name="__Annotation__71370_3974847206"/></text:p>
     </table:table-cell>
